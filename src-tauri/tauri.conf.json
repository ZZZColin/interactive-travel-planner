{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TripPath",
  "version": "0.1.0",
  "identifier": "cn.pedoc.trippath",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:8765",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "TripPath · Interactive Travel Planner",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
